// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite doesn't support enums, using String instead
// UserRole: ADMIN, STAFF
// PaymentStatus: PENDING, PARTIAL, PAID
// PaymentMode: CASH, BANK_TRANSFER, CHEQUE, CARD, UPI, OTHER

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("STAFF") // ADMIN, STAFF
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoices      Invoice[]
  activityLogs  ActivityLog[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  gstNumber   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoices    Invoice[]
}

model Item {
  id          String   @id @default(cuid())
  name        String
  unitType    String   // sqft, unit, hour, etc.
  defaultRate Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoiceItems InvoiceItem[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  projectName     String?
  location        String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  paymentStatus   String        @default("PENDING") // PENDING, PARTIAL, PAID
  subtotal        Float         @default(0)
  taxRate         Float         @default(0)
  taxAmount       Float         @default(0)
  discountRate    Float         @default(0)
  discountAmount  Float         @default(0)
  totalAmount     Float         @default(0)
  notes           String?
  templateId      String?
  template        Template?     @relation(fields: [templateId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           InvoiceItem[]
  payments        Payment[]
  activityLogs    ActivityLog[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  quantity    Float
  rate        Float
  total       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id            String      @id @default(cuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   DateTime    @default(now())
  paymentMode   String      // CASH, BANK_TRANSFER, CHEQUE, CARD, UPI, OTHER
  referenceNumber String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  htmlContent String   // HTML template with placeholders
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoices    Invoice[]
}

model Settings {
  id                String   @id @default(cuid())
  companyName       String
  companyEmail      String?
  companyPhone      String?
  companyAddress    String?
  companyGst        String?
  companyWebsite    String?
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  invoicePrefix     String   @default("INV")
  invoiceSequence   Int      @default(1)
  taxRate           Float    @default(18) // Default GST rate
  logoUrl           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id])
  action      String   // created, updated, deleted, viewed, etc.
  description String?
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())
}

